# Admin — never index login or dashboard
/admin
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store

# Long-cache immutable hashed assets from Vite builds
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — long cache; filenames are versioned by path
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static media (posters / compressed loops)
/video/*
  Cache-Control: public, max-age=604800

/logos/*
  Cache-Control: public, max-age=604800

/glance/*
  Cache-Control: public, max-age=604800

/challenges/*
  Cache-Control: public, max-age=604800

/brand/*
  Cache-Control: public, max-age=604800
