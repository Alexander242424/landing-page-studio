# Admin — never index login or dashboard
/admin
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store

# Long-cache immutable hashed assets from Vite builds
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — long cache; filenames are versioned by path
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static media (posters / compressed loops)
/video/*
  Cache-Control: public, max-age=604800

/logos/*
  Cache-Control: public, max-age=604800

/glance/*
  Cache-Control: public, max-age=604800

/challenges/*
  Cache-Control: public, max-age=604800

/brand/*
  Cache-Control: public, max-age=604800

# Discovery files — short cache so LLM / search indexes pick up updates
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llm.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/humans.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
