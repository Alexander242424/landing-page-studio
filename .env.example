# Lovable AI Gateway (existing — required for Gemini replies)
LOVABLE_API_KEY=

# Chat persistence (optional but recommended)
# Create a Supabase project, run:
#   supabase/migrations/20260311_chat_events.sql
#   supabase/migrations/20260817_case_studies.sql
#   supabase/migrations/20260817_articles.sql
#   supabase/migrations/20260817_analytics_events.sql
# then set these. Prefer the service role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if service role is unavailable (enable an insert policy if used):
# SUPABASE_ANON_KEY=

# Without Supabase in local Node/dev:
#   Chat events append to .data/chat-events.jsonl
#   Work / case studies fall back to the seed in src/lib/cases.ts
#   Articles fall back to the seed in src/lib/articles.ts
#   Article read analytics need the analytics_events migration
# The browser always mirrors the last ~500 events in localStorage
# under key `uxlab:chat-events-queue`.

# Telegram alerts — chat started (intent_open) + new leads
# 1) Message @BotFather → /newbot → copy token
# 2) Message your bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy chat.id (or your group id)
# Local: put these in `.env` (not committed) and restart `vite dev`.
# Production (Lovable): set the same names in project secrets, then redeploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: multiple recipients, comma-separated
# TELEGRAM_CHAT_IDS=123456789,-100987654321

# Daily analytics Telegram digest (20:00 Europe/Warsaw).
# Hit GET/POST /api/cron/daily-digest with this secret (cron-job.org or similar).
# Cloudflare cron can also call scheduled() hourly; the job only sends at 20:00 Warsaw.
CRON_SECRET=

# Admin panel (/admin/login) — HTTP-only encrypted session cookie.
# Must be at least 32 characters in production.
ADMIN_SESSION_SECRET=uxlab-admin-dev-session-secret-change-me!!
# Super-admin email (password is scrypt-hashed under data/admin-users.json):
#   alex@uxdrive.io
# Page analytics JSONL: data/analytics/events.jsonl
